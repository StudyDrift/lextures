        "name": "non_ai_survives_all_ai_kill",
        "toolId": "flashcards",
        "capabilities": [],
        "killedToolIds": [],
        "killedCapabilities": [],
        "killAllAI": true,
        "expected": false
      }
    ]
  },
  "reportReachability": {
    "maxTaps": 2,
    "overflowThenReportTaps": 2
  },
  "telemetryPayloadShape": {
    "allowedKeys": ["tool_id", "platform", "outcome", "error_class", "reason", "event"],
    "forbiddenValueSubstrings": ["prompt:", "state_json", "free_text=", "peer_content="],
    "validExamples": [
      { "tool_id": "ask_questions", "platform": "ios", "outcome": "blocked", "error_class": "consent" },
      { "tool_id": "flashcards", "platform": "android", "outcome": "ok" }
    ],
    "invalidExamples": [
      { "tool_id": "ask_questions", "prompt": "what is photosynthesis?" },
      { "tool_id": "inline_discussion", "free_text": "hello classmates" }
    ]
  },
  "filterCrisis": {
    "cases": [
      {
        "name": "filtered_block",
        "errorCode": "filtered",
        "crisis": false,
        "expectedKind": "filtered",
        "preserveDraft": true,
        "retry": false
      },
      {
        "name": "crisis_escalation",
        "errorCode": "filtered",
        "crisis": true,
        "expectedKind": "crisis",
        "preserveDraft": true,
        "retry": false
      },
      {
        "name": "generic_error",
        "errorCode": "provider_unavailable",
        "crisis": false,
        "expectedKind": "generic",
        "preserveDraft": true,
        "retry": true
      }
    ]
  },
  "messageKeys": {
    "block_not_available": "mobile.contentTools.governance.notAvailableInCourse",
    "block_capability": "mobile.contentTools.governance.notAvailableInCourse",
    "block_killed": "mobile.contentTools.governance.killed",
    "block_breaker": "mobile.contentTools.governance.temporarilyUnavailable",
    "block_tombstone": "mobile.contentTools.governance.withdrawn",
    "block_deprecated": "mobile.contentTools.governance.withdrawn",
    "block_unknown": "mobile.contentTools.governance.unavailable",
    "block_stale_policy": "mobile.contentTools.governance.policyStale"
  }
