  "killDerivation": {
    "cases": [
      {
        "name": "tool_killed",
        "toolId": "ask_questions",
        "capabilities": ["ai"],
        "killedToolIds": ["ask_questions"],
        "killedCapabilities": [],
        "killAllAI": false,
        "expected": true
      },
      {
        "name": "capability_killed",
        "toolId": "ask_questions",
        "capabilities": ["ai"],
        "killedToolIds": [],
        "killedCapabilities": ["ai"],
        "killAllAI": false,
        "expected": true
      },
      {
        "name": "all_ai_killed",
        "toolId": "explain_it_back",
        "capabilities": ["ai"],
        "killedToolIds": [],
        "killedCapabilities": [],
