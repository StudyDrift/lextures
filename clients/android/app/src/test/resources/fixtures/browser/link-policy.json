{
  "description": "MB.1 shared MobileLinkPolicy fixture table — iOS and Android must classify identically.",
  "constants": {
    "allowedSchemes": ["http", "https", "mailto", "tel", "sms", "geo", "maps", "itms-apps", "market", "lextures"],
    "nativeAppHostSuffixes": [
      "zoom.us",
      "zoom.com",
      "meet.google.com",
      "teams.microsoft.com",
      "teams.live.com"
    ],
    "checkoutHostSuffixes": [
      "checkout.stripe.com",
      "billing.stripe.com",
      "pay.stripe.com"
    ],
    "ssoPathMarkers": ["/oauth", "/oidc", "/saml", "/sso", "/auth/callback", "/login/oauth"]
  },
  "cases": [
    {
      "name": "relative_courses_path",
      "url": "/courses/abc",
      "policy": "in_app",
      "flagOn": true,
      "apiHost": "api.lextures.com",
      "want": "native"
    },
    {
      "name": "lextures_scheme",
      "url": "lextures://courses/abc",
      "policy": "in_app",
      "flagOn": true,
      "apiHost": "api.lextures.com",
      "want": "native"
    },
    {
      "name": "first_party_https_path",
      "url": "https://app.lextures.com/courses/abc",
      "policy": "in_app",
      "flagOn": true,
      "apiHost": "api.lextures.com",
      "want": "native"
    },
    {
      "name": "localhost_first_party",
      "url": "http://localhost:5173/settings/account",
      "policy": "in_app",
      "flagOn": true,
      "apiHost": "127.0.0.1:8080",
      "want": "native"
    },
    {
      "name": "external_https_in_app",
      "url": "https://en.wikipedia.org/wiki/Photosynthesis",
