  "bearerAttachment": [
    {
      "name": "exact_api_host",
      "requestHost": "api.lextures.com",
      "apiHost": "api.lextures.com",
      "want": true
    },
    {
      "name": "subdomain_of_api",
      "requestHost": "cdn.api.lextures.com",
      "apiHost": "api.lextures.com",
      "want": true
    },
    {
      "name": "lookalike_prefix",
      "requestHost": "api.lextures.com.example.net",
      "apiHost": "api.lextures.com",
      "want": false
    },
    {
      "name": "unrelated",
      "requestHost": "evil.example",
      "apiHost": "api.lextures.com",
      "want": false
    },
    {
      "name": "port_stripped",
      "requestHost": "api.lextures.com:443",
      "apiHost": "api.lextures.com",
      "want": true
    },
    {
      "name": "localhost_dev",
      "requestHost": "127.0.0.1",
      "apiHost": "127.0.0.1:8080",
      "want": true
    }
  ],
  "telemetryShape": {
    "allowedKeys": ["source", "classification", "outcome", "errorClass"],
    "forbiddenKeys": ["url", "host", "path", "title", "href", "pageTitle"]
  }
}
