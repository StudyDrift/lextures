{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "formFactor": "mobile",
        "throttling": {
          "rttMs": 60,
          "throughputKbps": 4096,
          "cpuSlowdownMultiplier": 4
        },
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "emulatedFormFactor": "mobile"
      },
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/pricing/",
        "http://127.0.0.1:4173/k12/",
        "http://127.0.0.1:4173/higher-ed/",
        "http://127.0.0.1:4173/homeschool/",
        "http://127.0.0.1:4173/blog/the-synthetic-renaissance/",
        "http://127.0.0.1:4173/docs/self-hosting/",
        "http://127.0.0.1:4173/courses/",
        "http://127.0.0.1:4173/pricing/calculator/",
        "http://127.0.0.1:4173/privacy/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "interactive": ["error", { "maxNumericValue": 3500 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
